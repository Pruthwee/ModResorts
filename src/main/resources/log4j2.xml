<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <!-- Cloud SDK, HTTP wire and request loggers stay at WARN so no secret or wire data is logged -->
    <Logger name="com.azure" level="warn"/>
    <Logger name="com.azure.core.http" level="warn"/>
    <Logger name="com.microsoft.aad.msal4j" level="warn"/>
    <Logger name="reactor.netty" level="warn"/>
    <Logger name="io.netty" level="warn"/>
    <Logger name="org.apache.http.wire" level="warn"/>
    <Logger name="org.apache.http.headers" level="warn"/>
    <Root level="error">
      <AppenderRef ref="STDOUT"/>
    </Root>
  </Loggers>
</Configuration>
